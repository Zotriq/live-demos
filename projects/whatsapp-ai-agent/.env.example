# Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAG...                 # permanent system-user token in production
WHATSAPP_PHONE_NUMBER_ID=1234567890
META_APP_SECRET=...                    # App settings → Basic → App secret (signs every webhook)
WHATSAPP_VERIFY_TOKEN=pick-any-string  # same value you enter when adding the webhook in Meta

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

SLACK_WEBHOOK_URL=                     # where handoffs and errors are posted for staff
ADMIN_TOKEN=change-me
DATABASE_PATH=whatsapp_agent.db
