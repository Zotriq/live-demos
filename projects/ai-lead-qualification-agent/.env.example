# =============================================================================
# AI Lead Qualification Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values before starting the project.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# PostgreSQL connection details used by both Docker Compose and the backend.
POSTGRES_USER=leadagent
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=lead_qualification
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full async DSN assembled by the backend (override if hosting externally).
DATABASE_URL=postgresql+asyncpg://leadagent:change_me_in_production@postgres:5432/lead_qualification

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Your OpenAI API key — required for lead scoring and AI analysis.
OPENAI_API_KEY=sk-...

# Model to use for lead qualification analysis (e.g. gpt-4o, gpt-4o-mini).
OPENAI_MODEL=gpt-4o

# Maximum tokens the AI may produce per analysis response.
OPENAI_MAX_TOKENS=1500

# Sampling temperature for AI responses (0 = deterministic, 1 = creative).
OPENAI_TEMPERATURE=0.2

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Shared secret used to sign JWT tokens for the dashboard API.
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars

# Token expiry in minutes (default 1 day = 1440 minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins — comma-separated list of frontend URLs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to "production" to disable debug features and auto-reload.
ENVIRONMENT=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Webhook Authentication
# -----------------------------------------------------------------------------
# A static API key clients must send in the X-API-Key header when posting leads.
WEBHOOK_API_KEY=replace_with_a_random_webhook_secret

# Optional HMAC secret for verifying HubSpot / n8n webhook signatures.
WEBHOOK_SECRET=replace_with_hmac_signing_secret

# -----------------------------------------------------------------------------
# Lead Scoring Thresholds
# -----------------------------------------------------------------------------
# Leads with a score >= HOT_THRESHOLD are classified as "hot".
HOT_THRESHOLD=80

# Leads with a score >= WARM_THRESHOLD (and below hot) are classified as "warm".
WARM_THRESHOLD=50

# -----------------------------------------------------------------------------
# Email Notifications (SMTP)
# -----------------------------------------------------------------------------
# SMTP server hostname (e.g. smtp.gmail.com for Gmail).
SMTP_HOST=smtp.gmail.com

# SMTP port — 587 for STARTTLS, 465 for SSL.
SMTP_PORT=587

# SMTP account username / email address.
SMTP_USER=your-email@gmail.com

# SMTP account password or app-specific password.
SMTP_PASSWORD=your_smtp_password

# "From" address shown on outgoing notification emails.
SMTP_FROM=noreply@yourdomain.com

# Recipient(s) for new hot-lead alerts — comma-separated.
ALERT_EMAIL_TO=sales@yourdomain.com

# Set to "true" to enable email alerts for hot leads.
EMAIL_ALERTS_ENABLED=false

# -----------------------------------------------------------------------------
# Google Calendar Integration (optional)
# -----------------------------------------------------------------------------
# Path to the OAuth 2.0 credentials JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials/google_credentials.json

# Calendar ID to use when booking discovery-call events.
# Use "primary" for the account's main calendar.
GOOGLE_CALENDAR_ID=primary

# Default duration (in minutes) for auto-scheduled discovery calls.
DISCOVERY_CALL_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# CRM Integration (optional)
# -----------------------------------------------------------------------------
# HubSpot private-app token for syncing qualified leads back to HubSpot.
HUBSPOT_API_KEY=

# Salesforce connected-app credentials (leave blank if not using Salesforce).
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
# Base URL of the backend API — must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
