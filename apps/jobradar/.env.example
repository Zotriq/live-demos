# Copy this file to .env and fill in what you have. Everything is optional:
# without keys the app still runs (rule scoring, Slack previews, local SQLite).

# AI scoring (any OpenAI-compatible API). Groq is free to start: console.groq.com
GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b

# Slack: create an Incoming Webhook for your channel (api.slack.com/apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=#new-jobs

# Database: leave empty for local SQLite (data/job_radar.db),
# or paste a Supabase / Postgres connection string:
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
